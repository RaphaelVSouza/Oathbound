{
  "rtk-rewrite": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.gemini/antigravity-cli/oathbound-hook rtk-hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
