  "rtk-rewrite": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node __HOME__/.gemini/antigravity-cli/rtk-hook.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
