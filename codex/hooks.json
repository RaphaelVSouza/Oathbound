{
  "hooks": {
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "oathbound-hook codex-agent-audit", "statusMessage": "Oathbound subagent start audit" }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "oathbound-hook codex-agent-audit", "statusMessage": "Oathbound subagent stop audit" }] }],
    "PreToolUse": [{ "matcher": "Bash", "hooks": [
      { "type": "command", "command": "oathbound-hook codex-subagent-guard", "statusMessage": "Oathbound guard (subagents only)" },
      { "type": "command", "command": "rtk hook codex", "statusMessage": "RTK shell command rewrite" }
    ] }]
  }
}
